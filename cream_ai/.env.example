# Скопируйте этот файл в .env и укажите реальные значения.
# НИКОГДА не коммитьте .env с реальным ключом в репозиторий.

# Ключ Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Необязательно: модель Gemini (по умолчанию gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Необязательно: базовый URL Gemini API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Необязательно: порт backend-сервера (по умолчанию 8080)
PORT=8080

# Необязательно: разрешённые origin для CORS (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
